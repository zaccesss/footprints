{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "footprints hook pre"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "footprints hook post"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "footprints hook post"
          }
        ]
      }
    ]
  }
}
